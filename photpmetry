            awk_cmd = (
                f"awk 'NR > 1 && $17 != 99.999 && $19 != 99.999 && $25 == 0 && $7 > -0.3 && $7 < 0.3 "
                f"{{print $3, $4, $17, $19, $11, $6, $7, $8, $10, $25}}' {phot_output} > {stars_data_file}"
            )
            print(f"执行命令: {awk_cmd}")
            subprocess.run(awk_cmd, shell=True, check=True)
            
            # 检查输出文件
            if not os.path.exists(stars_data_file):
                print(f"错误: 筛选后的星表 {stars_data_file} 未生成")
                continue
            
            print(f"测光结果提取成功: {stars_data_file}")
            
            # 步骤5: 坐标转换
            print("\n" + "-"*50)
            print(f"步骤5: {wavelength} 波段坐标转换")
            print("-"*50)
            # 获取参考FITS文件
            ref_fits = glob.glob("*_drc.chip1.fits")
            if not ref_fits:
                print("错误: 未找到参考FITS文件")
                continue
            
            ref_fits = ref_fits[0]  # 使用第一个_drc.chip1文件作为参考
            
            # 设置输出文件路径
            transformed_file = os.path.join(os.path.dirname(output_dir), f"J{folder_id}_{wavelength}.txt")
            
            # 执行坐标转换
            transform_coordinates(
                input_txt=stars_data_file,
                output_txt=transformed_file,
                fits_file=ref_fits,
                folder_id=folder_id,
                wavelength=wavelength
            )
            
            print(f"{wavelength} 波段处理完成! 结果保存在: {transformed_file}")
            
        except subprocess.CalledProcessError as e:
            print(f"处理失败: {e}")
        finally:
            # 恢复原始工作目录
            os.chdir(original_dir)
            print(f"恢复原始工作目录: {original_dir}")
    
    print("\n" + "="*50)
    print("所有波段处理完成!")
    print("="*50)

