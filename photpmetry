            print(f"步骤1: {wavelength} 波段图像裁剪")
            print("-"*50)
            if not process_cut(input_dir, output_dir, target_ra, target_dec, r_reff):
                print("裁剪处理失败，跳过此波段")
                continue
            
            # 步骤2: 生成DOLPHOT参数文件
            print("\n" + "-"*50)
            print(f"步骤2: {wavelength} 波段生成参数文件")
            print("-"*50)
            param_file = generate_dolphot_param(output_dir, wavelength, folder_id)
            if not param_file:
                print("参数文件生成失败，跳过此波段")
                continue
            
            # 切换到输出目录，后续步骤都在这里执行
            os.chdir(output_dir)
            print(f"切换到工作目录: {os.getcwd()}")
            
            # 步骤3: 运行DOLPHOT
            print("\n" + "-"*50)
            print(f"步骤3: {wavelength} 波段运行DOLPHOT")
