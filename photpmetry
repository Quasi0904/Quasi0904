def clean_header(header):
    """清理头文件中的干扰关键字"""
    clean_header = header.copy()
    for key in list(clean_header.keys()):
        if key.startswith(('D2IM', 'CPDIS', 'SIP_', 'DP')):
            del clean_header[key]
    return clean_header

def create_wcs(header):
    """创建WCS对象，处理可能的错误"""
    try:
        return WCS(header, relax=True)
    except Exception as e:
        print(f"警告: 无法创建WCS - {str(e)}")
        # 尝试手动创建基本WCS
        if 'CRVAL1' in header and 'CRPIX1' in header:
            wcs_orig = WCS(naxis=2)
            wcs_orig.wcs.crval = [header['CRVAL1'], header['CRVAL2']]
            wcs_orig.wcs.crpix = [header['CRPIX1'], header['CRPIX2']]
            wcs_orig.wcs.cdelt = [header.get('CDELT1', 1e-5), header.get('CDELT2', 1e-5)]
            wcs_orig.wcs.ctype = [header.get('CTYPE1', 'RA---TAN'), header.get('CTYPE2', 'DEC--TAN')]
            return wcs_orig
        else:
            print(f"错误: 无法创建基本WCS")

def cutout_fits(input_path, output_path, ra_deg, dec_deg, radius_arcsec):
    """裁剪FITS图像到目标区域"""
    try:
        with fits.open(input_path) as hdul:
            if len(hdul) == 0:
                print(f"错误: {os.path.basename(input_path)} 没有HDU，跳过")
                return False
                
            # 获取数据和头文件
            sci_data = hdul[0].data
            orig_header = hdul[0].header.copy()
            
            # 清理头文件并创建WCS
            clean_hdr = clean_header(orig_header)
            wcs_orig = create_wcs(clean_hdr)
            if wcs_orig is None:
                return False
            
            # 将天空坐标转换为像素坐标
            coord = SkyCoord(ra_deg, dec_deg, unit='deg')
            try:
                x, y = wcs_orig.all_world2pix(coord.ra.deg, coord.dec.deg, 0)
            except Exception as e:
                print(f"警告: 坐标转换失败 - {str(e)}")
                return False
            
            # 计算像素比例（角秒/像素）
            pixel_scale = np.abs(wcs_orig.proj_plane_pixel_scales()[0].value) * 3600
            if np.isnan(pixel_scale) or pixel_scale <= 0:
                pixel_scale = 0.05  # ACS/WFC的默认像素比例
            
            # 计算裁剪尺寸（像素）
            size_pix = int(radius_arcsec / pixel_scale)
            
            # 确保裁剪框在图像范围内
            naxis1, naxis2 = orig_header['NAXIS1'], orig_header['NAXIS2']
            xmin = max(0, int(x - size_pix/2))
            xmax = min(naxis1, int(x + size_pix/2))
            ymin = max(0, int(y - size_pix/2))
            ymax = min(naxis2, int(y + size_pix/2))
            
            width = xmax - xmin
            height = ymax - ymin
            
            if width <= 10 or height <= 10:
                print(f"警告: 裁剪区域过小({width}x{height}像素)，跳过处理")
                return False
            
            # 创建裁剪位置和尺寸
            position = (xmin + width/2, ymin + height/2)
            size = (height, width)  # (y_size, x_size)
            
            # 执行裁剪
            cutout = Cutout2D(sci_data, position, size, wcs=wcs_orig)
            
            # 更新头文件 - 保留所有原信息
            new_header = orig_header.copy()
            
            # 更新关键头信息
            new_header['NAXIS1'] = cutout.shape[1]
            new_header['NAXIS2'] = cutout.shape[0]
            new_header['CRPIX1'] = cutout.wcs.wcs.crpix[0]
            new_header['CRPIX2'] = cutout.wcs.wcs.crpix[1]
            
            # 添加裁剪信息
            new_header['RA_CENT'] = (ra_deg)
            new_header['DEC_CENT'] = (dec_deg)
            new_header['CUT_RAD'] = (radius_arcsec)
            new_header.add_history(f"Cropped by {radius_arcsec} arcsec at [{ra_deg}, {dec_deg}]")
            
            # 创建新的HDU
            new_hdu = fits.PrimaryHDU(cutout.data, header=new_header)
            
            # 保存新文件
            new_hdu.writeto(output_path, overwrite=True)
            return True
    except Exception as e:
        import traceback
        print(f"严重错误处理 {os.path.basename(input_path)}: {str(e)}")
        print(traceback.format_exc())
        return False

def check_chip_coverage(input_path, ra_deg, dec_deg):
    """精确检查目标是否在chip内 - 使用WCS转换"""
    try:
        with fits.open(input_path) as hdul:
            if len(hdul) == 0:
                return False
                
            # 清理头文件并创建WCS
            clean_hdr = clean_header(hdul[0].header)
            wcs_orig = create_wcs(clean_hdr)
            if wcs_orig is None:
                return False
            
            # 将天空坐标转换为像素坐标
            coord = SkyCoord(ra_deg, dec_deg, unit='deg')
            try:
                x, y = wcs_orig.all_world2pix(coord.ra.deg, coord.dec.deg, 0)
            except Exception:
                return False
            
            # 检查像素坐标是否在图像范围内
            naxis1 = clean_hdr.get('NAXIS1', 0)
            naxis2 = clean_hdr.get('NAXIS2', 0)
            
            # 添加10像素的边界容差
            return (x >= -10 and x < naxis1 + 10 and 
                    y >= -10 and y < naxis2 + 10)
    except Exception:
        return False

def find_matching_sky_file(chip_path):
    """查找与chip文件对应的sky文件"""
    base_name = os.path.basename(chip_path)
    
    # 尝试匹配文件名模式
    if ".chip" in base_name:
        # 替换.chip为.sky
        sky_name = base_name.replace(".chip", ".sky")
        sky_path = os.path.join(os.path.dirname(chip_path), sky_name)
        if os.path.exists(sky_path):
            return sky_path
        
        # 尝试另一种模式：在chip后添加.sky
        parts = base_name.split('.')
        if len(parts) > 1:
            # 例如: jbf408h4q_flc.chip1.fits -> jbf408h4q_flc.chip1.sky.fits
            sky_name = '.'.join(parts[:-1]) + '.sky.' + parts[-1]
            sky_path = os.path.join(os.path.dirname(chip_path), sky_name)
            if os.path.exists(sky_path):
                return sky_path
    
    return None

def process_cut(input_dir, output_dir, target_ra, target_dec, r_reff, multiplier=5.0):
    """处理所有chip文件的裁剪（科学图像加波段，sky文件不改名）"""
    from astropy.io import fits

    radius_arcsec = multiplier * r_reff
    os.makedirs(output_dir, exist_ok=True)

    processed = 0
    skipped = 0
    error_count = 0
    sky_processed = 0
    sky_missing = 0
    results = []  # [(科学图像路径, 波段名), ...]

    chip_files = [f for f in os.listdir(input_dir) if f.endswith(('chip1.fits', 'chip2.fits'))]

    for filename in chip_files:
        input_path = os.path.join(input_dir, filename)

        # 检查目标是否在chip内
        if not check_chip_coverage(input_path, target_ra, target_dec):
            skipped += 1
            continue

        output_path = os.path.join(output_dir, filename)

        # 裁剪chip（科学图像）
        if cutout_fits(input_path, output_path, target_ra, target_dec, radius_arcsec):
            # 读取FILTER，加波段名
            filt = 'UNKNOWN'
            try:
                hdr = fits.getheader(output_path)
                filt = hdr.get('FILTER')
                if filt is None:
                    with fits.open(output_path) as hdul:
                        if len(hdul) > 1:
                            filt = hdul[1].header.get('FILTER')
                if filt:
                    filt = filt.lower()
                    base, ext = os.path.splitext(output_path)
                    if '_flc' in base:
                        base = base.replace('_flc', f'_{filt}_flc')
                    elif '_drc' in base:
                        base = base.replace('_drc', f'_{filt}_drc')
                    new_path = base + ext
                    os.rename(output_path, new_path)
                    output_path = new_path
                    results.append((output_path, filt.upper()))
                else:
                    results.append((output_path, 'UNKNOWN'))
            except Exception as e:
                results.append((output_path, 'UNKNOWN'))

            processed += 1

            # 裁剪sky（不改名也不加波段）
            sky_path = find_matching_sky_file(input_path)
            if sky_path and os.path.exists(sky_path):
                sky_output = os.path.join(output_dir, os.path.basename(sky_path))
                if cutout_fits(sky_path, sky_output, target_ra, target_dec, radius_arcsec):
                    sky_processed += 1
                else:
                    sky_missing += 1
            else:
                sky_missing += 1
        else:
            error_count += 1

    print(f"\n裁剪处理完成! 裁剪成功chip图像: {processed}, sky图像: {sky_processed}, 跳过: {skipped}, 错误: {error_count}")
    if sky_missing:
        print(f"警告: {sky_missing} 个chip文件未找到对应sky图像")

    return results  

