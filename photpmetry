def transform_coordinates(input_txt, output_txt, fits_file, folder_id, wavelength):
    """
    执行坐标转换
    :param input_txt: 输入星表文件
    :param output_txt: 输出星表文件
    :param fits_file: 参考FITS文件
    :param folder_id: 文件夹ID
    :param wavelength: 波长值
    """
    try:
        # 读取FITS文件获取WCS
        with fits.open(fits_file) as hdul:
            wcs = WCS(hdul[0].header)
    except FileNotFoundError:
        print(f"错误：找不到FITS文件 {fits_file}")
        return False
    
    try:
        # 读取像素坐标和星等数据
        data = np.loadtxt(input_txt)
    except FileNotFoundError:
        print(f"错误：找不到数据文件 {input_txt}")
        return False
    
    # 处理数据
    if data.ndim == 1:
        # 如果只有一行数据，转换为二维数组
        data = data.reshape(1, -1)
    
    x_pix = data[:, 0]
    y_pix = data[:, 1]
    mag = data[:, 2]
    mag_uncertenty = data[:,3]
    
    # 像素坐标转天球坐标
    sky_coords = wcs.pixel_to_world(x_pix, y_pix)
    ra = sky_coords.ra.deg
    dec = sky_coords.dec.deg
    
    # 保存结果
    output_data = np.column_stack((ra, dec, mag, mag_uncertenty))
    np.savetxt(output_txt, output_data, 
               fmt='%.8f %.8f %.3f %.3f',
               header=f'RA(deg) DEC(deg) MAG MAG_uncertainty', 
               comments='#')
    
    print(f'转换完成! 结果已保存至: {output_txt}')
    print(f'处理详情: 文件夹 {folder_id}, 波长 {wavelength}')
    return True

