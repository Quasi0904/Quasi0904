def extract_catalog_with_coords(phot_path, ref_image_path, band_filters, output_txt):
    """
    读取 DOLPHOT phot 文件，结合参考图像 WCS 转换成 RA/DEC，并输出包含各波段 MAG/ERR 的源表。
    """
    # 读取 phot 数据
    data = np.loadtxt(phot_path, comments='#')

    # 获取像素坐标（DOLPHOT列定义第3、4列为X/Y像素）
    x_pix = data[:, 2]
    y_pix = data[:, 3]

    # 加载参考图像的WCS并转换
    with fits.open(ref_image_path) as hdul:
        wcs = WCS(hdul[0].header)
    sky_coords = wcs.pixel_to_world(x_pix, y_pix)
    ra_deg = sky_coords.ra.deg
    dec_deg = sky_coords.dec.deg

    # 提取每个波段的 VegaMag 及其误差
    band_results = []
    for b in band_filters:
        if b.endswith('F475W'):
            mag_col = 16   # 第17列 (0-based索引16)
            err_col = 18   # 第19列 (0-based索引18)
        elif b.endswith('F814W'):
            mag_col = 29   # 第30列
            err_col = 31   # 第32列
        else:
            raise ValueError(f"未知波段 {b}")
        mags = data[:, mag_col]
        errs = data[:, err_col]
        band_results.append((mags, errs))

    # 组装输出数组
    cols = [ra_deg, dec_deg]
    header_cols = ["RA", "DEC"]
    for i, b in enumerate(band_filters):
        cols.append(band_results[i][0])
        cols.append(band_results[i][1])
        header_cols.append(f"{b}_MAG")
        header_cols.append(f"{b}_ERR")

    out_arr = np.column_stack(cols)
    header = " ".join(header_cols)
    np.savetxt(output_txt, out_arr, fmt="%.6f", header=header)
    print(f"星表已保存到: {output_txt}")

def process_photometry_multi(params):
    """多波段联合测光"""
    raw_dir = params['raw_dir']
    data_dir = params['data_dir']
    folder_id = params['folder_id']
    target_ra = params['target_ra']
    target_dec = params['target_dec']
    r_reff = params['r_reff']

    # 第一步：裁剪所有chip文件
    cut_results = process_cut(raw_dir, data_dir, target_ra, target_dec, r_reff)
    if not cut_results:
        print("无裁剪结果，结束。")
        return

    cut_files = [os.path.basename(p) for p, _ in cut_results]
    band_names = [b for _, b in cut_results]  # 记录波段对应顺序

    # 第二步：生成.param文件
    science_files = [f for f in cut_files if '.sky.' not in f]

    drc_files = [f for f in science_files if '_drc.chip1' in f]
    if not drc_files:
        print("未找到 _drc.chip1 参考图像")
        return

    # 选第一张 drc 作为参考图像
    ref_image = drc_files[0]
    ref_base = os.path.splitext(ref_image)[0]

    # 其他 science 文件 = flc 文件（排除所有 drc/sky）
    science_others = [f for f in science_files if '_drc.chip1' not in f]

    param_file = os.path.join(data_dir, f"{folder_id}.param")
    with open(param_file, "w") as f:
        f.write(f"Nimg = {len(science_others)}\n")
        f.write(f"img0_file = {ref_base}\nimg0_shift = 0 0\nimg0_xform = 1 0 0\n")
        for idx, img in enumerate(science_others, start=1):
            f.write(f"img{idx}_file = {os.path.splitext(img)[0]}\n")
            f.write(f"img{idx}_shift = 0 0\nimg{idx}_xform = 1 0 0\n")
        # 固定参数
        f.write("""
    RAper = 3
    Rchi = 3.0
    PSFPhot = 1
    FitSky = 2
    RSky0 = 15
    Rsky1 = 35
    SkipSky = 2
    SkySig = 2.25
    SecondPass = 5
    SearchMode = 1
    SigFind = 2.5
    SigFindMult = 0.85
    SigFinal = 3.5
    SubResRef = 1
    MaxIT = 25
    NoiseMult = 0.10
    FSat = 0.999
    FlagMask = 4
    ApCor = 1
    Force1 = 1
    Align = 2
    Rotate = 1
    RCentroid = 1
    PosStep = 0.25
    dPosMax = 2.5
    RCombine = 3.0
    RPSF = 10
    SigPSF = 5.0
    PSFres = 1
    psfoff = 0.0
    DiagPlotType = PS
    UseWCS = 1
    ACSpsfType = 0
    InterpPSFlib = 1
    ACSuseCTE = 0
    CombineChi = 1
    """)

    # 第三步：运行 DOLPHOT
    phot_path = os.path.join(data_dir, f"{folder_id}.phot")
    subprocess.run(f"cd {data_dir} && dolphot {phot_path} -p{os.path.basename(param_file)}", shell=True, check=True)

    # 第四步：转换 RA/DEC 提取星表
    ref_image_path = os.path.join(data_dir, ref_image)
    output_txt = os.path.join(BASE_OUTPUT_DIR, f"J{folder_id}", f"{folder_id}.txt")
    extract_catalog_with_coords(phot_path, ref_image_path, ['ACS_F475W', 'ACS_F814W'], output_txt)

if __name__ == "__main__":
    params = get_user_input()
    if params:
        process_photometry_multi(params)
