def process_photometry(params):
    """执行测光与分析流程"""
    # 解包参数
    folders = params['folders']
    input_dirs = params['input_dirs']
    output_dirs = params['output_dirs']
    folder_id = params['folder_id']
    target_ra = params['target_ra']
    target_dec = params['target_dec']
    r_reff = params['r_reff']
    
    # 保存原始工作目录
    original_dir = os.getcwd()
    
    # 处理每个波段
    for i, folder in enumerate(folders):
        input_dir = input_dirs[i]
        output_dir = output_dirs[i]
        wavelength = folder['wavelength']
        
        print("\n" + "="*50)
        print(f"开始处理 {wavelength} 波段")
        print("="*50)
        
